# Copia este archivo a .env y sustituye estos valores de ejemplo.
# .env no se versiona. No compartas su contenido.
POSTGRES_DB=dasradio
POSTGRES_USER=dasradio
POSTGRES_PASSWORD=cambia-esta-contrasena-local
SERVICE_TOKEN=cambia-este-token-interno
RADIO_PORT=8000
SEED_DEMO=true
STATION_ID=1

# El perfil discord se habilita cuando el bot está preparado.
# Para arrancar los tres servicios con docker compose up --build:
# COMPOSE_PROFILES=discord
COMPOSE_PROFILES=
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
