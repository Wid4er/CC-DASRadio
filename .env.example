# CONFIGURACION LOCAL DE CC-DASRadio
# El arranque crea .env si falta; incluye Discord automaticamente si sus tres campos estan completos.
# Solo el modo --discord se detiene si falta configurar el bot.
# Este archivo .env.example es solo una plantilla; edita tu .env local.
# .env no se versiona. No compartas su contenido.

# PostgreSQL: puedes conservar el nombre y el usuario predeterminados.
POSTGRES_DB=dasradio
POSTGRES_USER=dasradio
# El arranque genera estas dos claves automaticamente al crear .env.
# Si copias la plantilla a mano, sustituye ambos valores por claves propias.
POSTGRES_PASSWORD=cambia-esta-contrasena-local
SERVICE_TOKEN=cambia-este-token-interno

# Opcionales: puertos locales de la web y API, catalogo de prueba y emisora.
WEB_PORT=8080
RADIO_PORT=8000
SEED_DEMO=true
STATION_ID=1

# La evaluacion web arranca sin Discord: web, API y PostgreSQL.
# Para anadir el bot con Compose, pon discord. El lanzador detecta sus campos automaticamente.
# --web-only omite el bot; --discord exige su configuracion.
COMPOSE_PROFILES=

# Tutorial opcional: docs/configurar-discord.md o /ayuda/discord en la web.
# Si el bot no esta disponible, puedes evaluar con ./scripts/start.sh --web-only.
# SOLO PARA EL BOT OPCIONAL: pega a la derecha de = el token del bot.
# Discord Developer Portal > tu aplicacion > Bot > Token.
# No es el Client Secret de OAuth2. No publiques ni envies este valor.
DISCORD_TOKEN=

# SOLO PARA EL BOT: ID de la aplicacion, en General Information > Application ID.
DISCORD_CLIENT_ID=

# SOLO PARA EL BOT: ID del servidor Discord de referencia (no el del canal).
# /radio se registra globalmente; no hay que cambiar este ID al anadir otros servidores.
# En Discord, activa el modo desarrollador y copia el ID del servidor.
DISCORD_GUILD_ID=
